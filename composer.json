{
    "name": "webstrategy/ws-paste-cleaner",
    "description": "WordPress plugin that strips Microsoft Word formatting on paste in Gutenberg and the Classic Editor.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/WordPress-freelance/ws-paste-cleaner",
    "authors": [
        {
            "name": "WebStrategy",
            "homepage": "https://wordpress-freelance.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "10up/wp_mock": "^0.5",
        "yoast/phpunit-polyfills": "^1.1"
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "test:coverage": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
